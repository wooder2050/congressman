generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Term {
  id        Int      @id // 대수 번호 (e.g., 22, 21)
  name      String // "제22대"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  memberTerms    MemberTerm[]
  attendances    Attendance[]
  bills          Bill[]
  votes          Vote[]
  schedules      Schedule[]
  meetingMinutes MeetingMinutes[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Party {
  id        String @id // "democratic", "ppp", etc.
  name      String @unique // "더불어민주당"
  shortName String // "민주당"
  color     String // "#1B56DB"

  memberTerms       MemberTerm[]
  electionDistricts ElectionDistrict[]
  candidates        Candidate[]

  localElectionCandidates LocalElectionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id           String  @id // MONA_CD from API or mock id
  name         String
  photoUrl     String  @default("")
  birthDate    String?
  electedCount Int     @default(1)
  career       String? // MEM_TITLE: 경력사항 텍스트 (줄바꿈 구분)

  memberTerms       MemberTerm[]
  memberVotes       MemberVote[]
  assets            Asset[]
  billProposers     BillProposer[]
  electionDistricts ElectionDistrict[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model MemberTerm {
  id               Int      @id @default(autoincrement())
  memberId         String
  termId           Int
  partyId          String
  district         String   @default("")
  proportional     Boolean  @default(false)
  committees       String[] @default([])
  committeeHistory Json     @default("[]") // 전체 위원회 이력 [{name, startDate, endDate}]
  committeeRoles   Json     @default("{}") // {"법제사법위원회": "위원장", "예산결산특별위원회": "위원"}
  electedCount     Int      @default(1) // 해당 대수 기준 선수

  member Member @relation(fields: [memberId], references: [id])
  term   Term   @relation(fields: [termId], references: [id])
  party  Party  @relation(fields: [partyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, termId])
  @@index([memberId])
  @@index([termId])
  @@index([partyId])
}

model Attendance {
  id            Int    @id @default(autoincrement())
  memberId      String
  termId        Int
  totalSessions Int    @default(0)
  attended      Int    @default(0)
  absent        Int    @default(0)
  leave         Int    @default(0) // 청가
  travel        Int    @default(0) // 출장
  rate          Float  @default(0)

  term Term @relation(fields: [termId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, termId])
  @@index([memberId])
  @@index([termId])
}

model Bill {
  id                   String  @id // BILL_ID from API or mock id
  title                String
  proposerName         String  @default("")
  coProposerCount      Int     @default(0)
  status               String  @default("pending") // passed, pending, discarded, committee
  proposedDate         String
  termId               Int
  committee            String?
  committeeDate        String? // 위원회 회부일
  committeePresentDate String? // 위원회 상정일
  committeeResultCode  String? // 위원회 처리결과
  committeeResultDate  String? // 위원회 처리일
  lawSubmitDate        String? // 법사위 회부일
  lawPresentDate       String? // 법사위 상정일
  lawResultCode        String? // 법사위 처리결과
  lawResultDate        String? // 법사위 처리일
  plenaryDate          String? // 본회의 처리일
  summary              String? // 제안이유 및 주요내용
  simpleSummary        String? // AI 원라이너 요약
  structuredSummary    Json? // { situation, problem, change, impact }
  topic                String? // 주제 카테고리
  pdfBookId            String? // 의안원문 PDF bookId
  detailLink           String? // 의안정보시스템 상세 URL

  term      Term           @relation(fields: [termId], references: [id])
  proposers BillProposer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([termId, status])
  @@index([termId])
  @@index([status])
}

model BillProposer {
  id       Int    @id @default(autoincrement())
  billId   String
  memberId String
  role     String @default("co") // "representative" = 대표발의, "co" = 공동발의

  bill   Bill   @relation(fields: [billId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@unique([billId, memberId])
  @@index([billId])
  @@index([memberId, role])
  @@index([role])
}

model Vote {
  id           String  @id // BILL_ID from API
  billNo       String  @default("")
  billName     String
  committee    String?
  procDate     String // 표결일 (YYYY-MM-DD)
  procResult   String // 원문: "원안가결", "수정가결", "부결" 등
  resultCode   String // 정규화: passed, amended, rejected, discarded, other
  billKind     String  @default("")
  memberTotal  Int     @default(0) // 재적
  voteTotal    Int     @default(0) // 투표
  yesCount     Int     @default(0) // 찬성
  noCount      Int     @default(0) // 반대
  abstainCount Int     @default(0) // 기권
  linkUrl      String  @default("")
  termId       Int

  term        Term         @relation(fields: [termId], references: [id])
  memberVotes MemberVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([termId, procDate])
  @@index([termId, resultCode])
  @@index([termId])
  @@index([procDate])
  @@index([resultCode])
}

model MemberVote {
  id       Int    @id @default(autoincrement())
  memberId String
  voteId   String
  result   String // "yes", "no", "abstain", "absent"

  member Member @relation(fields: [memberId], references: [id])
  vote   Vote   @relation(fields: [voteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([memberId, voteId])
  @@index([memberId])
  @@index([voteId, memberId, result])
}

model Asset {
  id           Int    @id @default(autoincrement())
  memberId     String
  year         Int
  category     String
  item         String
  amount       BigInt @default(0)
  relation     String @default("본인")
  changeReason String @default("") // 변동사유 (신규등록, 가액변동, 매입 등)

  member Member @relation(fields: [memberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, year, category, item, relation])
  @@index([memberId, year])
  @@index([memberId])
  @@index([year])
}

model Schedule {
  id            Int    @id @default(autoincrement())
  type          String // "plenary" (본회의) | "committee" (위원회)
  title         String
  meetingDate   String // YYYY-MM-DD
  meetingTime   String @default("")
  session       String @default("")
  degree        String @default("")
  committeeName String @default("")
  agenda        String @default("")
  linkUrl       String @default("")
  termId        Int

  term Term @relation(fields: [termId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, meetingDate, meetingTime, committeeName, degree])
  @@index([termId, type, meetingDate])
  @@index([termId])
  @@index([meetingDate])
  @@index([type])
}

model MeetingMinutes {
  id            String @id // CONF_ID
  conferNum     String // CONFER_NUM (회의 번호)
  title         String // TITLE
  className     String @default("") // CLASS_NAME (회의 구분)
  committeeName String // COMM_NAME
  confDate      String // CONF_DATE (YYYY-MM-DD)
  agendas       Json   @default("[]") // [{subName, vodLinkUrl, confLinkUrl, pdfLinkUrl}]
  termId        Int

  term Term @relation(fields: [termId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([termId])
  @@index([committeeName])
  @@index([confDate])
}

model SyncLog {
  id          Int       @id @default(autoincrement())
  syncType    String // "members", "bills", "attendance"
  termId      Int?
  status      String // "started", "completed", "failed"
  recordCount Int       @default(0)
  errorMsg    String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

// ====== 재보궐선거 ======

model ByElection {
  id           String   @id // "2026-06-03"
  name         String // "6·3 재보궐선거"
  electionDate DateTime
  description  String   @default("")
  status       String   @default("upcoming") // upcoming | active | completed

  districts ElectionDistrict[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ElectionDistrict {
  id                 Int     @id @default(autoincrement())
  electionId         String
  district           String // "인천 계양을" (MemberTerm.district 형식)
  region             String  @default("") // "인천"
  vacancyReason      String // "대통령 당선"
  previousMemberId   String?
  previousMemberName String  @default("")
  previousPartyId    String?
  confirmed          Boolean @default(true)
  status             String  @default("upcoming")

  election       ByElection  @relation(fields: [electionId], references: [id])
  previousMember Member?     @relation(fields: [previousMemberId], references: [id])
  previousParty  Party?      @relation(fields: [previousPartyId], references: [id])
  candidates     Candidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([electionId, district])
}

model Candidate {
  id              Int     @id @default(autoincrement())
  districtId      Int
  name            String
  partyId         String?
  photoUrl        String?
  birthDate       String?
  career          String? // 줄바꿈 구분
  education       String?
  slogan          String?
  pledges         Json    @default("[]") // [{category, title, description}]
  assets          String? // 재산 요약 텍스트
  memberIdRef     String? // 기존 의원이면 Member.id 참조
  huboid          String? @unique // NEC 후보자 ID (사진/상세 페이지 키)
  candidateNumber Int? // 기호 번호
  status          String  @default("registered")

  // 후보자정보공개자료 (공직선거법 제49조, info.nec.go.kr 상세 페이지 요약)
  assetDeclared      BigInt? // 재산신고액 (원)
  militaryService    String? // 병역신고사항(본인)
  taxPaid            BigInt? // 최근 5년 납세 납부액 (원)
  taxOverdue5y       BigInt? // 최근 5년 체납액 (원)
  taxOverdueCurrent  BigInt? // 현 체납액 (원)
  criminalRecord     String? // 전과기록
  electionCount      Int? // 입후보 횟수
  assetPdfUrls       String[] @default([]) // 재산신고서 원문 PDF URL 목록 (NEC, 페이지순)
  assetPagePngUrls   String[] @default([]) // PDF를 PNG로 변환해 Supabase Storage에 미러링한 URL (페이지순). 비어있으면 pending
  assetPdfSourceHash String? // assetPdfUrls의 hash — 원본 변경 감지 후 재처리 트리거
  assetPdfSyncStatus String? // "pending" | "completed" | "failed" | "stale" (URL 변경 감지)
  assetPdfSyncError  String? // 실패 사유

  district   ElectionDistrict     @relation(fields: [districtId], references: [id])
  party      Party?               @relation(fields: [partyId], references: [id])
  assetItems CandidateAssetItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([districtId, name])
}

// ====== 지방선거 ======

model LocalElection {
  id           String   @id // "local-2026"
  name         String // "제9회 전국동시지방선거"
  electionDate DateTime
  description  String   @default("")
  status       String   @default("upcoming") // upcoming | active | completed
  ordinal      Int // 9 (회차)

  races LocalElectionRace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocalElectionRace {
  id           Int    @id @default(autoincrement())
  electionId   String
  electionType String // "governor" | "mayor" | "metro-council" | "local-council" | "superintendent"
  sido         String // "서울특별시"
  sigungu      String @default("") // "수원시" (governor/superintendent는 빈 문자열)
  district     String @default("") // "가", "나" (council용)
  displayName  String // "서울특별시장", "수원시장" 등
  seatCount    Int    @default(1) // 기초의원 중선거구는 2~4석

  sgId       String @default("") // NEC 선거ID
  sgTypecode String @default("") // NEC 선거종류코드

  election   LocalElection            @relation(fields: [electionId], references: [id])
  candidates LocalElectionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([electionId, electionType, sido, sigungu, district])
  @@index([electionId, electionType])
  @@index([electionId, sido])
}

model LocalElectionCandidate {
  id              Int     @id @default(autoincrement())
  raceId          Int
  name            String
  partyId         String?
  photoUrl        String?
  birthDate       String?
  gender          String?
  career          String? // 줄바꿈 구분
  education       String?
  slogan          String?
  pledges         Json    @default("[]") // [{category, title, description}]
  assets          String? // 재산 요약 텍스트
  candidateNumber Int? // 기호 번호
  status          String  @default("registered") // registered | elected | defeated
  voteCount       Int?
  voteRate        Float?
  isWinner        Boolean @default(false)
  huboid          String  @default("") // NEC 후보자 ID
  memberIdRef     String? // 현직 의원이면 Member.id

  // 후보자정보공개자료 (공직선거법 제49조, info.nec.go.kr 상세 페이지 요약)
  assetDeclared      BigInt? // 재산신고액 (원)
  militaryService    String? // 병역신고사항(본인)
  taxPaid            BigInt? // 최근 5년 납세 납부액 (원)
  taxOverdue5y       BigInt? // 최근 5년 체납액 (원)
  taxOverdueCurrent  BigInt? // 현 체납액 (원)
  criminalRecord     String? // 전과기록 (예: "없음", "1건")
  electionCount      Int? // 입후보 횟수
  assetPdfUrls       String[] @default([]) // 재산신고서 원문 PDF URL 목록 (NEC, 페이지순)
  assetPagePngUrls   String[] @default([]) // PDF를 PNG로 변환해 Supabase Storage에 미러링한 URL (페이지순). 비어있으면 pending
  assetPdfSourceHash String? // assetPdfUrls의 hash — 원본 변경 감지 후 재처리 트리거
  assetPdfSyncStatus String? // "pending" | "completed" | "failed" | "stale" (URL 변경 감지)
  assetPdfSyncError  String? // 실패 사유

  race       LocalElectionRace    @relation(fields: [raceId], references: [id])
  party      Party?               @relation(fields: [partyId], references: [id])
  assetItems CandidateAssetItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([raceId, name])
  @@index([raceId])
  @@index([partyId])
}

// ====== 후보자 재산 항목별 상세 ======
// 한 행 = 하나의 자산 항목 (예: "조국 + 본인 + 건물 + 방배삼익아파트 + 16.74억")
// 여러 소스(opengirok 국회공보, PETI 인사혁신처, NEC PDF OCR, manual)를 동일 스키마로 적재
model CandidateAssetItem {
  id Int @id @default(autoincrement())

  // Polymorphic relation: 둘 중 하나만 채워짐
  localCandidateId Int? // 지방선거 후보
  byCandidateId    Int? // 재보궐 후보

  // 자산 분류
  category    String // 토지·건물·예금·증권·채무·자동차·정치자금예금·고지거부·채권·가상자산·회원권·현금·골동품·출자지분·지식재산권·보석·기부·금
  subCategory String? // 재산의 종류 (예: 아파트·임야·상장주식·자동차)
  relation    String // 본인·배우자·부·모·장남·차남·장녀·차녀·삼남·삼녀·손자1·손녀1·조모 등
  description String // 소재지·면적·종목·계좌 등 상세 명세 (원본 텍스트 보존)

  // 금액 (원 단위, 천원→원 변환 후 저장)
  currentValue  BigInt? // 현재가액 / 신고가액
  previousValue BigInt? // 종전가액 (opengirok 정기변동신고에만)
  increaseValue BigInt? // 증가액
  decreaseValue BigInt? // 감소액
  marketPrice   BigInt? // 실거래가격
  changeReason  String? // 변동사유 (예: "가액변동", "신규취득")

  // 메타데이터
  source     String // "opengirok" | "peti" | "nec_ocr" | "manual"
  sourceUrl  String? // 원본 URL (구글시트 URL, PETI 페이지 URL 등)
  sourceDate String? // 신고/공보 발행일 (YYYY-MM-DD)
  rawJson    Json? // 원본 행 전체(스키마 변경 대비)

  localCandidate LocalElectionCandidate? @relation(fields: [localCandidateId], references: [id], onDelete: Cascade)
  byCandidate    Candidate?              @relation(fields: [byCandidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([localCandidateId])
  @@index([byCandidateId])
  @@index([source])
  @@index([category])
}

// ====== 유저 환경설정 ======

model UserPreference {
  id                     Int      @id @default(autoincrement())
  userId                 String   @unique // Supabase auth.users UUID
  displayName            String?
  district               String? // 관심 지역구 (예: "서울 강남갑")
  interests              String[] @default([]) // 관심 토픽 (예: ["보건·의료", "부동산·주거"])
  bookmarkedBills        String[] @default([]) // 저장한 법안 ID
  bookmarkedMembers      String[] @default([]) // 저장한 의원 ID
  bookmarkedBreakingNews String[] @default([]) // 저장한 속보 ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ====== 속보 ======

model BreakingNews {
  id          String   @id // 예: "2026-05-01-labor-day-holiday"
  title       String
  description String
  date        DateTime // 발행일
  category    String // "committee" | "election" | "legislation" | "politics"
  items       Json     @default("[]") // BreakingNewsDetail[] {label, value, memberId?}
  sources     Json     @default("[]") // {title, url}[]
  linkUrl     String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) // 같은 날짜 내 정렬용

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, date])
}

// ====== 주간 뉴스 ======

model WeeklyArticle {
  id            String   @id // 예: "2026-05-w1"
  title         String // 표시 제목 (예: "5월 1주차")
  period        String // 기간 (예: "2026.05.04 ~ 05.10")
  publishedDate DateTime // 발행일
  summary       String // 한 줄 요약
  tags          String[] @default([]) // 핵심 키워드 태그
  featuredBills Json     @default("[]") // FeaturedBill[]
  highlights    Json     @default("[]") // WeeklyHighlight[]
  stats         Json? // WeeklyStats {billsPassed?, billsProposed?, votesHeld?, committeeMeetings?}
  analysis      String? // 이번 주 분석

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedDate])
}
