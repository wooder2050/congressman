{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts && tsx prisma/seed-elections.ts",
    "seed:elections": "tsx prisma/seed-elections.ts",
    "sync": "tsx src/sync/sync-runner.ts",
    "sync:members": "tsx src/sync/sync-runner.ts members",
    "sync:bills": "tsx src/sync/sync-runner.ts bills",
    "sync:bills-safe": "tsx src/sync/sync-runner.ts bills-safe",
    "sync:votes": "tsx src/sync/sync-runner.ts votes",
    "sync:photos": "tsx src/sync/sync-runner.ts photos",
    "sync:member-votes": "tsx src/sync/sync-runner.ts member-votes",
    "sync:attendance": "tsx src/sync/sync-runner.ts attendance",
    "sync:assets": "tsx src/sync/sync-runner.ts assets",
    "sync:bill-content": "tsx src/sync/sync-runner.ts bill-content",
    "sync:schedules": "tsx src/sync/sync-runner.ts schedules",
    "sync:daily": "tsx src/sync/sync-daily.ts",
    "sync:weekly": "tsx src/sync/sync-weekly.ts",
    "sync:local-elections": "tsx src/sync/sync-runner.ts local-elections",
    "sync:local-election-results": "tsx src/sync/sync-runner.ts local-election-results",
    "seed:local-elections": "tsx prisma/seed-local-elections.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.105.1",
    "@upstash/redis": "^1.34.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "knip": "^5.0.0",
    "prettier": "^3.8.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
